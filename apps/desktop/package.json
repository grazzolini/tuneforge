{
  "name": "@tuneforge/desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "android:prepare": "node ../../scripts/package-android.mjs --prepare",
    "android:icons": "tauri icon --output src-tauri/target/android-icons src-tauri/icons/icon.png",
    "android:build": "node ../../scripts/package-android.mjs",
    "android:build:debug": "node ../../scripts/package-android.mjs --debug",
    "android:build:release": "node ../../scripts/package-android.mjs --publishable",
    "android:studio": "bash ../../scripts/android-arm64-env.sh tauri android dev --open",
    "dev": "vite",
    "lint": "eslint .",
    "tauri": "bash ../../scripts/run-tauri-command.sh",
    "test": "vitest",
    "test:e2e": "node ../../scripts/desktop-e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "~2.4.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tuneforge/shared-types": "workspace:*",
    "lucide-react": "^1.32.0",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
