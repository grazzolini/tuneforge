+static constexpr int32_t WHISPER_BACKEND_MASK_CPU = 1 << 0;
+static constexpr int32_t WHISPER_BACKEND_MASK_GPU = 1 << 1;
+static constexpr int32_t WHISPER_BACKEND_MASK_UNKNOWN = 1 << 2;
+
+static bool whisper_is_inference_compute_op(enum ggml_op op) {
+    switch (op) {
+        case GGML_OP_NONE:
+        case GGML_OP_DUP:
+        case GGML_OP_SET:
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return false;
+        default:
+            return true;
+    }
+}
+
+static int32_t whisper_graph_backend_mask(
+    ggml_backend_sched_t   sched,
+        struct ggml_cgraph * graph) {
+    int32_t mask = 0;
+    for (int index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+        struct ggml_tensor * node = ggml_graph_node(graph, index);
+        if (!whisper_is_inference_compute_op(node->op)) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, node);
+        if (backend == nullptr) {
+            mask |= WHISPER_BACKEND_MASK_UNKNOWN;
+            continue;
+        }
+        ggml_backend_dev_t device = ggml_backend_get_device(backend);
+        if (device == nullptr) {
+            mask |= WHISPER_BACKEND_MASK_UNKNOWN;
+            continue;
+        }
+        const enum ggml_backend_dev_type type = ggml_backend_dev_type(device);
+        if (type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            mask |= WHISPER_BACKEND_MASK_GPU;
+        } else {
+            mask |= WHISPER_BACKEND_MASK_CPU;
+        }
+    }
+    return mask;
+}
+
+static int32_t whisper_backend_type_from_mask(int32_t mask) {
+    if ((mask & WHISPER_BACKEND_MASK_GPU) != 0) {
+        return 1;
+    }
+    if ((mask & WHISPER_BACKEND_MASK_UNKNOWN) != 0) {
+        return -1;
+    }
+    if ((mask & WHISPER_BACKEND_MASK_CPU) != 0) {
+        return 0;
+    }
+    return -1;
+}
+
+static void whisper_record_completed_graph(
+                        bool   completed,
+        ggml_backend_sched_t   sched,
+          struct ggml_cgraph * graph,
+                   int32_t * completed_backend_mask) {
+    if (completed && completed_backend_mask != nullptr) {
+        *completed_backend_mask |= whisper_graph_backend_mask(sched, graph);
+    }
+}
