+
+struct whisper_dtw_word {
+    whisper_token_data * first;
+    whisper_token_data * last;
+    size_t token_count;
+    std::string text;
+};
+
+static bool whisper_dtw_ascii_punctuation(const std::string & text) {
+    size_t start = text.find_first_not_of(" \t\r\n");
+    if (start == std::string::npos) {
+        return false;
+    }
+    size_t end = text.find_last_not_of(" \t\r\n");
+    const std::string stripped = text.substr(start, end - start + 1);
+    const std::string punctuation = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
+    return punctuation.find(stripped) != std::string::npos;
+}
+
+static bool whisper_dtw_valid_utf8(const std::string & text) {
+    size_t index = 0;
+    while (index < text.size()) {
+        const unsigned char lead = text[index++];
+        size_t continuation = 0;
+        if (lead <= 0x7f) {
+            continue;
+        } else if (lead >= 0xc2 && lead <= 0xdf) {
+            continuation = 1;
+        } else if (lead >= 0xe0 && lead <= 0xef) {
+            continuation = 2;
+        } else if (lead >= 0xf0 && lead <= 0xf4) {
+            continuation = 3;
+        } else {
+            return false;
+        }
+        if (index + continuation > text.size()) {
+            return false;
+        }
+        while (continuation-- > 0) {
+            if ((static_cast<unsigned char>(text[index++]) & 0xc0) != 0x80) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static std::string whisper_dtw_trim_ascii(const std::string & text) {
+    const size_t start = text.find_first_not_of(" \t\r\n");
+    if (start == std::string::npos) {
+        return "";
+    }
+    return text.substr(start, text.find_last_not_of(" \t\r\n") - start + 1);
+}
+
+static int64_t whisper_exp_adjust_word_timestamps_dtw(
+            struct whisper_context * ctx,
+              struct whisper_state * state,
+                               int   i_segment,
+                            size_t   n_segments,
+                       const char * language,
+                           int64_t   last_speech_timestamp) {
+    const bool split_on_unicode = language && (
+            strcmp(language, "zh") == 0 || strcmp(language, "ja") == 0 ||
+            strcmp(language, "th") == 0 || strcmp(language, "lo") == 0 ||
+            strcmp(language, "my") == 0 || strcmp(language, "yue") == 0);
+    std::vector<whisper_dtw_word> words;
+    std::vector<size_t> segment_token_counts;
+    whisper_token_data * pending_first = nullptr;
+    whisper_token_data * pending_last = nullptr;
+    size_t pending_token_count = 0;
+    std::string pending_piece;
+    for (size_t segment_index = i_segment; segment_index < i_segment + n_segments; ++segment_index) {
+        auto & segment = state->result_all[segment_index];
+        size_t segment_token_count = 0;
+        for (auto & token : segment.tokens) {
+            if (token.id >= whisper_token_eot(ctx) || token.t_dtw < 0 || token.t_dtw_end < token.t_dtw) {
+                continue;
+            }
+            segment_token_count += 1;
+            if (pending_first == nullptr) {
+                pending_first = &token;
+            }
+            pending_last = &token;
+            pending_token_count += 1;
+            pending_piece += whisper_token_to_str(ctx, token.id);
+            if (!whisper_dtw_valid_utf8(pending_piece)) {
+                continue;
+            }
+            const std::string piece = pending_piece;
+            const bool starts_word = words.empty() || split_on_unicode ||
+                    (!piece.empty() && piece[0] == ' ') ||
+                    whisper_dtw_ascii_punctuation(piece);
+            if (starts_word) {
+                words.push_back({ pending_first, pending_last, pending_token_count, piece });
+            } else {
+                words.back().last = pending_last;
+                words.back().token_count += pending_token_count;
+                words.back().text += piece;
+            }
+            pending_first = nullptr;
+            pending_last = nullptr;
+            pending_token_count = 0;
+            pending_piece.clear();
+        }
+        segment_token_counts.push_back(segment_token_count);
+    }
+    if (words.empty() || pending_first != nullptr) {
+        return last_speech_timestamp;
+    }
+
+    std::vector<int64_t> durations;
+    for (const auto & word : words) {
+        const int64_t duration = word.last->t_dtw_end - word.first->t_dtw;
+        if (duration > 0) {
+            durations.push_back(duration);
+        }
+    }
+    int64_t median_duration = 0;
+    if (!durations.empty()) {
+        std::sort(durations.begin(), durations.end());
+        const size_t middle = durations.size() / 2;
+        median_duration = durations.size() % 2 == 0
+                ? (durations[middle - 1] + durations[middle]) / 2
+                : durations[middle];
+        median_duration = std::min<int64_t>(70, median_duration);
+    }
+    const int64_t max_duration = median_duration * 2;
+    const std::string sentence_end_marks = ".。!！?？";
+    for (size_t index = 1; median_duration > 0 && index < words.size(); ++index) {
+        auto & word = words[index];
+        if (word.last->t_dtw_end - word.first->t_dtw > max_duration) {
+            if (!word.text.empty() && sentence_end_marks.find(word.text) != std::string::npos) {
+                word.last->t_dtw_end = word.first->t_dtw + max_duration;
+            } else if (!words[index - 1].text.empty() && sentence_end_marks.find(words[index - 1].text) != std::string::npos) {
+                word.first->t_dtw = word.last->t_dtw_end - max_duration;
+            }
+        }
+    }
+
+    const std::string prepended = "\"'“¿([{-";
+    const std::string appended = "\"'.。,，!！?？:：”)]}、";
+    size_t following = words.size() - 1;
+    for (size_t cursor = words.size() - 1; cursor-- > 0;) {
+        auto & previous = words[cursor];
+        auto & next = words[following];
+        const std::string stripped = whisper_dtw_trim_ascii(previous.text);
+        if (!previous.text.empty() && previous.text[0] == ' ' &&
+                !stripped.empty() && prepended.find(stripped) != std::string::npos) {
+            next.text = previous.text + next.text;
+            next.token_count += previous.token_count;
+            previous.token_count = 0;
+            previous.text.clear();
+        } else {
+            following = cursor;
+        }
+    }
+    size_t previous = 0;
+    for (size_t following_index = 1; following_index < words.size(); ++following_index) {
+        auto & before = words[previous];
+        auto & after = words[following_index];
+        if (!before.text.empty() && before.text.back() != ' ' &&
+                !after.text.empty() && appended.find(after.text) != std::string::npos) {
+            before.text += after.text;
+            before.token_count += after.token_count;
+            after.token_count = 0;
+            after.text.clear();
+        } else {
+            previous = following_index;
+        }
+    }
+    words.erase(std::remove_if(words.begin(), words.end(), [](const whisper_dtw_word & word) {
+        return word.text.empty();
+    }), words.end());
+
+    size_t word_index = 0;
+    for (size_t segment_index = i_segment; segment_index < i_segment + n_segments; ++segment_index) {
+        auto & segment = state->result_all[segment_index];
+        std::vector<whisper_dtw_word *> segment_words;
+        size_t saved_tokens = 0;
+        const size_t token_budget = segment_token_counts[segment_index - i_segment];
+        while (word_index < words.size() && saved_tokens < token_budget) {
+            auto & word = words[word_index++];
+            saved_tokens += word.token_count;
+            segment_words.push_back(&word);
+        }
+        if (segment_words.empty()) {
+            continue;
+        }
+        auto & first = *segment_words.front();
+        auto & last = *segment_words.back();
+        if (median_duration > 0 &&
+                first.last->t_dtw_end - last_speech_timestamp > median_duration * 4 &&
+                (first.last->t_dtw_end - first.first->t_dtw > max_duration ||
+                 (segment_words.size() > 1 && segment_words[1]->last->t_dtw_end - first.first->t_dtw > max_duration * 2))) {
+            if (segment_words.size() > 1) {
+                auto & second = *segment_words[1];
+                if (second.last->t_dtw_end - second.first->t_dtw > max_duration) {
+                    const int64_t boundary = std::max(second.last->t_dtw_end / 2,
+                                                      second.last->t_dtw_end - max_duration);
+                    first.last->t_dtw_end = boundary;
+                    second.first->t_dtw = boundary;
+                }
+            }
+            first.first->t_dtw = std::max<int64_t>(0, first.last->t_dtw_end - max_duration);
+        }
+        if (segment.t0 < first.last->t_dtw_end && segment.t0 - 50 > first.first->t_dtw) {
+            first.first->t_dtw = std::max<int64_t>(
+                    0, std::min(first.last->t_dtw_end - median_duration, segment.t0));
+        } else {
+            segment.t0 = first.first->t_dtw;
+        }
+        if (segment.t1 > last.first->t_dtw && segment.t1 + 50 < last.last->t_dtw_end) {
+            last.last->t_dtw_end = std::max(
+                    last.first->t_dtw + median_duration, segment.t1);
+        } else {
+            segment.t1 = last.last->t_dtw_end;
+        }
+        last_speech_timestamp = segment.t1;
+    }
+    return last_speech_timestamp;
 }

 void whisper_log_set(ggml_log_callback log_callback, void * user_data) {
